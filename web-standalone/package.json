{
  "name": "langfuse-web-standalone",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema prisma/schema.prisma",
    "dev": "pnpm bootstrap && pnpm db:generate && pnpm db:deploy && next dev -H 127.0.0.1",
    "build": "pnpm bootstrap && pnpm db:generate && next build && node scripts/prepare-standalone.mjs",
    "start": "pnpm bootstrap && pnpm db:deploy && node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "pnpm bootstrap && pnpm db:generate && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.24",
    "@ai-sdk/anthropic": "4.0.16",
    "@ai-sdk/azure": "4.0.5",
    "@ai-sdk/google": "4.0.6",
    "@ai-sdk/google-vertex": "5.0.8",
    "@ai-sdk/openai": "4.0.16",
    "@ai-sdk/openai-compatible": "3.0.3",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.85.1",
    "@trpc/client": "11.13.4",
    "@trpc/next": "11.13.4",
    "@trpc/react-query": "11.13.4",
    "@trpc/server": "11.13.4",
    "ai": "7.0.8",
    "dotenv": "16.6.1",
    "lucide-react": "0.552.0",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "superjson": "2.2.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "prisma": "6.19.3",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
